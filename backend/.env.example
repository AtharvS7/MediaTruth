# ═══════════════════════════════════════════════════════════════
# MediaTruth Backend Environment Variables
# Copy this file to .env and fill in YOUR OWN values.
# ═══════════════════════════════════════════════════════════════
#
# ⚠️  SECURITY WARNING:
#   NEVER commit real keys to version control.
#   The values below are PLACEHOLDERS — replace them with your own.
#
# If you previously had real keys in this file, rotate them immediately:
#   Supabase Dashboard → Settings → API → Regenerate service_role key
# ═══════════════════════════════════════════════════════════════

ENV=development
PORT=8000
WORKERS=1

# Supabase — get these from: https://supabase.com/dashboard/project/YOUR-PROJECT/settings/api
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-from-supabase-dashboard

# Auth — change this to a strong random secret in production
JWT_SECRET=change-me-in-production

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
